# ---------------------------------------------------------------------------
# Analytics API — environment variable reference
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust values as needed.
# All defaults below match the docker-compose.yml setup and work out of the
# box for local development without any changes.
# ---------------------------------------------------------------------------

# Async database URL used by the FastAPI app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/analytics

# Sync database URL used by Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/analytics

# Uvicorn bind address and port
APP_HOST=0.0.0.0
APP_PORT=8000

# Set to "true" to automatically seed the database on container startup
SEED_DB=false

# Enable SQLAlchemy query echo logging (useful for debugging)
DEBUG=false

# Absolute path to the user → country CSV file inside the container
CSV_PATH=/app/user_country.csv
